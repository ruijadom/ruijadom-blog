+  align-items: center;
+  gap: 54px;
+  padding: 92px 0 74px;
+}
+.eyebrow {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+  font:
+    9px/1.8 var(--font-code),
+    monospace;
+  letter-spacing: 1.6px;
+  color: var(--mint);
+}
+.eyebrow i,
+.panelFoot i {
+  height: 5px;
+  width: 5px;
+  border-radius: 50%;
+  background: var(--mint);
+  box-shadow: 0 0 10px #7ce5d355;
+  display: inline-block;
+}
+.hero h1 {
+  font-size: clamp(36px, 3.7vw, 51px);
+  font-weight: 500;
+  line-height: 1.2;
+  letter-spacing: -2px;
+  margin: 24px 0;
+}
+.hero em,
+.gameCopy em,
+.biography em {
