+    radial-gradient(ellipse at 75% 4%, #152c3b55, transparent 34%), #090f19;
+  color: var(--ink);
+}
+.shell * {
+  box-sizing: border-box;
+}
+.shell a {
+  text-decoration: none;
+}
+.shell a,
+.shell button {
+  transition:
+    color 0.18s,
+    background 0.18s,
+    border-color 0.18s,
+    transform 0.18s;
+}
+.shell a:focus-visible,
+.shell button:focus-visible,
+.shell input:focus-visible {
+  outline: 2px solid var(--mint);
+  outline-offset: 5px;
+}
+.content {
+  flex: 1;
+  min-width: 0;
+  outline: none;
+}
+.skip {
+  position: fixed;
+  top: 10px;
+  left: 16px;
+  z-index: 1000;
+  transform: translateY(-150%);
+  background: var(--mint);
+  color: #09221f;
+  padding: 12px 20px;
+  border-radius: 8px;
+}
+.skip:focus {
+  transform: translateY(0);
+}
+.header {
+  position: sticky;
+  top: 0;
+  z-index: 60;
+  background: #090f19ed;
+  backdrop-filter: blur(16px);
+  border-bottom: 1px solid #ffffff0c;
