+.wordmark .markDot {
+  color: var(--mint);
+  margin-left: -9px;
+}
+.reading {
+  font:
+    8px/1.6 var(--font-code),
+    monospace;
+  letter-spacing: 1.3px;
+  color: #8d9eb5;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  flex: 1;
+  max-width: 390px;
+}
+.desktopNav {
+  display: flex;
+  gap: 27px;
+  margin-left: auto;
+  font-size: 12px;
+  white-space: nowrap;
+}
+.desktopNav a {
+  color: #a9b6ca;
+  padding: 10px 0;
+  position: relative;
+}
+.desktopNav a:hover,
+.desktopNav a[aria-current] {
+  color: var(--mint);
+}
+.desktopNav a[aria-current]:after {
+  content: "";
+  position: absolute;
+  bottom: 0;
+  left: 0;
+  right: 0;
+  height: 2px;
+  background: var(--mint);
+}
+.gameLink {
